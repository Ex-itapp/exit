# ─────────────────────────────────────────────────
# EX-IT App — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for webhooks, push notifications, cron jobs, and cross-user admin ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Dodo Payments ───────────────────────────────
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret
NEXT_PUBLIC_DODO_PRODUCT_MONTHLY=pdt_monthly_product_id
NEXT_PUBLIC_DODO_PRODUCT_YEARLY=pdt_yearly_product_id
# Optional: only payments for this product grant permanent Pro access.
# Leave unset if you do not sell a one-time lifetime plan.
# DODO_PRODUCT_LIFETIME=pdt_lifetime_product_id

# ─── AI Providers (at least one required) ────────
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── Web Push ────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ─── App ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin / Cron ────────────────────────────────
ADMIN_API_KEY=your-admin-api-key
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=your-cron-secret

# ─── Local development only ──────────────────────
# Enables the mock user + unlocks Pro features. NEVER set in production.
# NEXT_PUBLIC_AUTH_BYPASS=true
