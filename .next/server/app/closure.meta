{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/closure/layout,_N_T_/closure/page,_N_T_/closure"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/closure/__PAGE__",
    "/closure",
    "/_index",
    "/_head"
  ]
}